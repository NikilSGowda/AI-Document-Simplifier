# Comma-separated local development origins. No credentials are required in Phase 1.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Phase 2 upload limits (environment variables; .env is not auto-loaded).
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=200
